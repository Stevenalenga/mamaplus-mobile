# Copy to .env and fill in values. Restart Expo after changes (`npx expo start --clear`).
#
# This app connects to the MamaPlus Next.js portal API (mamaplus repo).
# The API URL must point to a running instance of the portal.

# ── Development ─────────────────────────────────────────────────────────────
# Expo web / iOS simulator:    http://localhost:3000
# Android emulator:            http://10.0.2.2:3000
# Physical device (Expo Go):   auto-detected, or set your PC LAN IP manually:
#   EXPO_PUBLIC_API_URL=http://192.168.1.x:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# ── Production ──────────────────────────────────────────────────────────────
# Set this when building for production (EAS Build / app store release):
# EXPO_PUBLIC_API_URL=https://mamaplus.co.ke

# Google OAuth — create clients at https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Microsoft OAuth — same Application ID as AZURE_AD_CLIENT_ID in the web app
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
