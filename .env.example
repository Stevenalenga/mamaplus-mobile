# Copy to mobile/.env and fill in values. Restart Expo after changes (`npx expo start --clear`).

# Backend API — must match where the Next.js portal runs (project root: npm run dev)
# Expo web / iOS simulator:  http://localhost:3000
# Android emulator:         http://10.0.2.2:3000
# Physical device (Expo Go): auto-detected from Metro, or set manually:
# EXPO_PUBLIC_API_URL=http://YOUR_PC_LAN_IP:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Google OAuth — create clients at https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Microsoft OAuth — same Application ID as AZURE_AD_CLIENT_ID in the web app
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=
